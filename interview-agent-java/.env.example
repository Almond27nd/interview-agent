# DashScope LLM (Required)
DASHSCOPE_API_KEY=sk-your-api-key
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL
MYSQL_URL=jdbc:mysql://localhost:3306/interview_agent?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=interview

# JWT
JWT_SECRET=interview-agent-default-secret

# GitHub (Optional)
GITHUB_TOKEN=

# 网页搜索（可选，Router 升级：出题 Agent 在题库之外的第二个检索源）
# 博查AI搜索 https://open.bochaai.com ，不配置则该工具不启用，出题 Agent 退化为只用题库
BOCHA_API_KEY=

# Auth
AUTH_ENABLED=true

# 可观测性（可选，不配置则 trace 不导出，面试流程不受影响）
# OTLP 后端：自建 Langfuse Docker / Grafana Tempo / 阿里云 ARMS
OTLP_ENDPOINT=http://localhost:4317
OTEL_SAMPLING_PROBABILITY=1.0
